<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Plone loads this file through the plone.autoinclude entry point of
       zoedb. When Zope opened its database, the handler gives
       portal_uidgenerator its ids from a sequence of the store. -->
  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".uidgenerator.database_opened"
      />

  <!-- The backends that ZOE_PLONE_BACKENDS names, at the start of Zope:
       locking, registry. Each one is opt-in. -->
  <subscriber
      for="zope.processlifetime.IProcessStarting"
      handler=".backends_from_environment"
      />

  <!-- The writes-on-GET report: each transaction of a request carries the
       method of the request, and zoe serve counts the records of the
       transactions of GET and HEAD requests by class. -->
  <subscriber
      for="ZPublisher.interfaces.IPubStart"
      handler=".report.request_started"
      />

</configure>
