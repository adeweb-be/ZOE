<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Plone loads this file through the plone.autoinclude entry point of
       zoedb. When Zope opened its database, the handler gives
       portal_uidgenerator its ids from a sequence of the store. -->
  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".uidgenerator.database_opened"
      />

  <!-- The backends that ZOE_PLONE_BACKENDS names: locking, indexing. They
       are opt-in. They install when the ZCML loads, so an instance, its
       scripts and bin/instance run see the same backends. -->
  <include
      package="z3c.zcmlhook"
      file="meta.zcml"
      />
  <zcml:customAction handler=".backends_from_environment" />

  <!-- The guard of a stock registry, with or without the registry backend:
       in a store with namespaces, a registry calls readCurrent on the
       roots of its trees when code reads its records. A move writes these
       roots, so a write that began before a move conflicts (ADR 0050). -->
  <zcml:customAction handler=".registry.install_guard" />

  <!-- Queued indexing, when its backend is installed: the thread of the
       indexer of each database, the wait of a request for the save of its
       user, and the status of the queue of a site. -->
  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".indexing.database_opened"
      />
  <subscriber
      for="ZPublisher.interfaces.IPubStart"
      handler=".indexing.request_started"
      />
  <include package="Products.Five" file="meta.zcml" />
  <browser:page
      name="zoe-indexing"
      for="Products.CMFCore.interfaces.ISiteRoot"
      class=".indexing.StatusView"
      permission="cmf.ManagePortal"
      />

  <!-- The writes-on-GET report: each transaction of a GET or a HEAD request
       carries the method of the request, and zoe serve counts the records
       of these transactions by class. -->
  <subscriber
      for="ZPublisher.interfaces.IPubStart"
      handler=".report.request_started"
      />

  <include package="plone.behavior" file="meta.zcml" />
  <include package="Products.GenericSetup" file="meta.zcml" />

  <!-- The opt-in behaviour of the append-only workflow history. Its status
       adapter gives an object of a type with the behaviour a
       WorkflowHistory at its next status. -->
  <plone:behavior
      name="zoe.plone.history"
      title="Append-only workflow history"
      description="Keeps the workflow history in a class whose transitions merge at the vote of the store, so that two transitions of one object do not conflict."
      provides=".history.IAppendOnlyHistory"
      />
  <adapter factory=".status.AppendOnlyWorkflowStatus" />

  <!-- A change of a Dexterity type derives the merge policy again, on a
       site where a profile with overrides was imported. -->
  <subscriber
      for="plone.dexterity.interfaces.IDexterityFTI
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".merges.fti_modified"
      />

  <!-- The profile writes the merge policy of the site into the store, and
       moves the workflow histories of the objects with the behaviour. -->
  <genericsetup:registerProfile
      name="default"
      title="ZOE"
      directory="profiles/default"
      description="Writes the merge policy of the site into the ZOE store, from its Dexterity types, and moves the workflow histories of the objects with the behaviour zoe.plone.history."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />
  <genericsetup:registerProfile
      name="uninstall"
      title="ZOE (uninstall)"
      directory="profiles/uninstall"
      description="Removes the behaviour zoe.plone.history from the types and gives each workflow history back as a PersistentMapping."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />
  <genericsetup:importStep
      name="zoe.plone.merge_policy"
      title="ZOE merge policy"
      description="Derives the merge policy of the site and writes it into the store, when the profile holds zoe-merge-policy.json."
      handler=".merges.import_merge_policy">
    <depends name="typeinfo" />
  </genericsetup:importStep>
  <genericsetup:importStep
      name="zoe.plone.history"
      title="ZOE workflow histories"
      description="Moves the workflow histories of the objects with the behaviour zoe.plone.history, when the profile holds zoe-plone-history.txt."
      handler=".history.import_histories">
    <depends name="typeinfo" />
  </genericsetup:importStep>
  <genericsetup:importStep
      name="zoe.plone.uninstall"
      title="ZOE uninstall"
      description="Gives each workflow history back as a PersistentMapping, when the profile holds zoe-plone-uninstall.txt."
      handler=".history.uninstall">
    <depends name="typeinfo" />
  </genericsetup:importStep>

</configure>
