<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Plone loads this file through the plone.autoinclude entry point of
       zoedb. When Zope opened its database, the handler gives
       portal_uidgenerator its ids from a sequence of the store. -->
  <subscriber
      for="zope.processlifetime.IDatabaseOpenedWithRoot"
      handler=".uidgenerator.database_opened"
      />

  <!-- The backend that ZOE_PLONE_BACKENDS names: locking. It is
       opt-in. They install when the ZCML loads, so an instance, its
       scripts and bin/instance run see the same backends. -->
  <include
      package="z3c.zcmlhook"
      file="meta.zcml"
      />
  <zcml:customAction handler=".backends_from_environment" />

  <!-- The writes-on-GET report: each transaction of a GET or a HEAD request
       carries the method of the request, and zoe serve counts the records
       of these transactions by class. -->
  <subscriber
      for="ZPublisher.interfaces.IPubStart"
      handler=".report.request_started"
      />

</configure>
