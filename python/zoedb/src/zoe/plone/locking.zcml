<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Opt in: the locks of plone.locking live in the ephemeral namespace of
       the store, and the lock of an edit form writes no object. Include
       this file in the ZCML of the site. The backend installs when the ZCML
       loads. -->
  <include
      package="z3c.zcmlhook"
      file="meta.zcml"
      />
  <zcml:customAction handler=".locking.install" />

</configure>
