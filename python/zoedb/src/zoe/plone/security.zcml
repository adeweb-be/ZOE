<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Opt in: allowedRolesAndUsers keeps the inherited inputs of each
       entry, and a share or a transition of a folder writes the entry of
       the folder alone (ADR 0061). Include this file in the ZCML of the
       site, in every instance of the site. The backend installs when the
       ZCML loads. -->
  <include
      package="z3c.zcmlhook"
      file="meta.zcml"
      />
  <zcml:customAction handler=".security.install" />

</configure>
