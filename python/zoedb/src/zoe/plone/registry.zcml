<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <!-- Opt in: the records of a registry can move to a durable namespace of
       the store (zoe.plone.registry.move). Include this file in the ZCML of
       the site. The backend installs when the ZCML loads. -->
  <include
      package="z3c.zcmlhook"
      file="meta.zcml"
      />
  <zcml:customAction handler=".registry.install" />

</configure>
