{
  "uid": "zoe",
  "title": "ZOE",
  "description": "The metrics of zoe serve, from /metrics on the admin port.",
  "tags": [
    "zoe",
    "zodb"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "storage",
        "label": "Storage",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(zoe_commits_total, storage)",
          "refId": "storage"
        },
        "definition": "label_values(zoe_commits_total, storage)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Commit latency (tpc_finish)",
      "description": "Time of each tpc_finish that ends a transaction, until the commit is durable and published: zoe_finish_latency_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (storage, le) (rate(zoe_finish_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (storage, le) (rate(zoe_finish_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Vote latency",
      "description": "Time of each vote, its lock wait included: zoe_vote_latency_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (storage, le) (rate(zoe_vote_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (storage, le) (rate(zoe_vote_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "fsync batch size",
      "description": "Number of commits that one sync of a commit batch makes durable: zoe_fsync_batch_size.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (storage) (rate(zoe_fsync_batch_size_sum{storage=~\"$storage\"}[$__rate_interval])) / sum by (storage) (rate(zoe_fsync_batch_size_count{storage=~\"$storage\"}[$__rate_interval]))",
          "legendFormat": "{{storage}} mean"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (storage, le) (rate(zoe_fsync_batch_size_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lock wait",
      "description": "Time of each vote to take its locks, a wait past lock-timeout included: zoe_lock_wait_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (storage, le) (rate(zoe_lock_wait_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (storage, le) (rate(zoe_lock_wait_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Conflicts",
      "description": "Oids in conflict that the server resolves, by path (zoe_conflicts_resolved_total), and transactions that end with a conflict (zoe_conflicts_raised_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (storage, path) (rate(zoe_conflicts_resolved_total{storage=~\"$storage\"}[$__rate_interval]))",
          "legendFormat": "{{storage}} resolved {{path}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (storage) (rate(zoe_conflicts_raised_total{storage=~\"$storage\"}[$__rate_interval]))",
          "legendFormat": "{{storage}} raised"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Invalidation queue depth",
      "description": "Frames that wait in the deepest hub queue among the connections of the storage: zoe_invalidation_queue_depth. client-queue-size bounds it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (storage) (zoe_invalidation_queue_depth{storage=~\"$storage\"})",
          "legendFormat": "{{storage}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Commits and loads",
      "description": "Commits of tpc_finish (zoe_commits_total) and loadBefore calls (zoe_loads_total) per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (storage) (rate(zoe_commits_total{storage=~\"$storage\"}[$__rate_interval]))",
          "legendFormat": "{{storage}} commits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (storage) (rate(zoe_loads_total{storage=~\"$storage\"}[$__rate_interval]))",
          "legendFormat": "{{storage}} loads"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Load latency",
      "description": "Time of each loadBefore call: zoe_load_latency_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (storage, le) (rate(zoe_load_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (storage, le) (rate(zoe_load_latency_seconds_bucket{storage=~\"$storage\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} p99"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Clients connected",
      "description": "Registered connections: zoe_clients_connected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (storage) (zoe_clients_connected{storage=~\"$storage\"})",
          "legendFormat": "{{storage}}"
        }
      ]
    }
  ]
}
