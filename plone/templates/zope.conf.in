%import zoe
%define INSTANCEHOME ${buildout:parts-directory}/instance
instancehome $INSTANCEHOME
debug-mode off
security-policy-implementation C
verbose-security off
default-zpublisher-encoding utf-8

<zodb_db main>
    cache-size 30000
    <zoe>
      path ${buildout:var-directory}/zoe
      blob-dir ${buildout:var-directory}/blobstorage
      backend redb
    </zoe>
    mount-point /
</zodb_db>
